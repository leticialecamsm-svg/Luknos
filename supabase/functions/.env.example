# ===========================================================================
# Edge Functions do Robô de Orçamentos WhatsApp — variáveis de ambiente
# ===========================================================================
# Uso LOCAL:  copie para `supabase/functions/.env` (git-ignored) e rode
#             `supabase functions serve --env-file supabase/functions/.env`
# Uso REMOTO: `supabase secrets set --env-file supabase/functions/.env`
#             (ou defina cada secret no painel: Project Settings > Edge Functions)
#
# NUNCA comite valores reais. Este arquivo só documenta os nomes.
# ---------------------------------------------------------------------------

# --- Supabase (injetadas automaticamente no ambiente deployado; defina só p/ local) ---
SUPABASE_URL=https://dpobbflxgrjbfpxmtehg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Project Settings > API > service_role (secret)
SUPABASE_ANON_KEY=                    # Project Settings > API > anon (public)

# --- Evolution API (WhatsApp — número dedicado do robô) ---
EVOLUTION_API_URL=                    # ex.: https://evo.suaempresa.com
EVOLUTION_API_KEY=                    # apikey global da instância Evolution
EVOLUTION_WEBHOOK_SECRET=             # segredo compartilhado p/ validar o webhook de entrada

# --- Sistema Luknos (Next.js) — endpoint de gravação de orçamento ---
# A base URL também fica em wa_bot_config.system_api_base_url; o secret abaixo
# é o valor real referenciado por wa_bot_config.system_api_key_secret_ref.
NEXTJS_API_URL=https://SEU_DOMINIO_LUKNOS            # ex.: https://app.luknos.com.br
NEXTJS_API_KEY=                        # API key do POST /api/external/quotes

# --- IA (opcional, evolução) — interpretação de linguagem natural no fluxo guiado ---
AI_API_KEY=                           # Claude Haiku / Gemini Flash (custo-eficiente)
AI_PROVIDER=anthropic                 # anthropic | google
